<?xml version="1.0" encoding="utf-8"?>
<!-- Imported into MuPDF's Visual Studio projects through ForceImportAfterCppTargets
     (see .cargo/config.toml): builds MuPDF for the static C runtime, like recto.exe. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
